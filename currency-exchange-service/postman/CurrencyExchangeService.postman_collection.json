{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Currency Exchange Service",
    "description": "Postman Collection for testing the Spring Boot Currency Exchange Microservice endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Welcome Endpoint",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/welcome",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "welcome"
          ]
        },
        "description": "Returns a simple welcome message to verify the service is running."
      },
      "response": []
    },
    {
      "name": "02 - Sample Currency Exchange (Mock)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/currency-exchange",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "currency-exchange"
          ]
        },
        "description": "Returns a mock/hardcoded CurrencyExchange payload."
      },
      "response": []
    },
    {
      "name": "03 - Get Exchange Rate (USD to INR)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/currency-exchange/from/USD/to/INR",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "currency-exchange",
            "from",
            "USD",
            "to",
            "INR"
          ]
        },
        "description": "Queries the database for USD to INR exchange rate and attaches local server port info."
      },
      "response": []
    },
    {
      "name": "04 - Get Exchange Rate (EUR to INR - Dynamic Path Params)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/currency-exchange/from/:from/to/:to",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "currency-exchange",
            "from",
            ":from",
            "to",
            ":to"
          ],
          "variable": [
            {
              "key": "from",
              "value": "EUR",
              "description": "Source Currency Code"
            },
            {
              "key": "to",
              "value": "INR",
              "description": "Target Currency Code"
            }
          ]
        },
        "description": "Dynamic request using Postman Path Variables."
      },
      "response": []
    }
  ]
}